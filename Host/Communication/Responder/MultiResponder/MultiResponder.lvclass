<?xml version='1.0' encoding='UTF-8'?>
<LVClass LVVersion="13008000">
	<Property Name="NI.Lib.DefaultMenu" Type="Str">MultiResponder.mnu</Property>
	<Property Name="NI.Lib.Description" Type="Str">The Multiresponder has a list of a number of named responders. Any response that is to be emitted will be sent by the responder whose name matches the "Sender" field of the response.

For example:  There exists a Multiresponder named "Serial Bus" that has three child responders named "1", "2" and "3". If a response with sender "1" is to be emitted, it will be emitted by the responder named "1" and the sender of the response will be changed to "Serial Bus". </Property>
	<Property Name="NI.Lib.HelpPath" Type="Str"></Property>
