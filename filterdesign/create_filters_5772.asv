%filter stage1
Hd1 = FminFilter(4, 7.05e6, 800e6, 0.02, 120);
num = -3*round(Hd1.numerator./min(Hd1.numerator));
%The four filter parts can be retrieved like this:
% num(1:4:end)
% num(2:4:end)
% num(3:4:end)
% num(4:4:end)

%Filter 2: CIC decimator 5, 4 stages, 1 cycle per sample (200MHz ->
%40MHz)

%Filter3: FIR decimator 4. (40MHz -> 10MHz)
%1 cycles per sample
Hd3 = FminFilterCicComp(4, 4, 2e6, 40e6, 0.02, 100);
coewrite(Hd2, 10, 'FIR_4decimate_ccomp_40MHz.coe');
%filter3: downsample 5 from 40 to 8Mhz (same as above..)
%filter3 will run 1/2 cycles

%filter4: downsample 4 from 8 to 2Mhz
%filter4 will run in 1/10
Hd4 = FminFilter(4, 1e6, 8e6, 0.02, 100);
coewrite(Hd4, 10, 'filter4_downsample4.coe');


%filter5: downsample 2 from 2MHz to 1Mhz
%filter5 will run in 1/40 (is actually 1/50..)
d = fdesign.lowpass(450e3/2e6, 500e3/2e6, 0.02, 80);
Hd5 = design(d);
Hd5.Arithmetic = 'Fixed';
Hd5.CoeffWordLength = 18;
coewrite(Hd5, 10, 'filter5_downsample2.coe');

